# Copy to .env at the repository root. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
WEB_PORT=8080
API_TOKEN=

# Set an absolute writable directory for native development.
# Leave unset to use the script's existing /opt/boris/vless-client layout.
# BASE_DIR=/absolute/path/to/local/profile-data
# ENV_FILE=/absolute/path/to/existing/client.env
# SECRETS_DIR=/absolute/path/to/existing/xray/secrets

# Existing server settings: the app does not provision Xray accounts.
VLESS_PUBLIC_HOST=
VLESS_PORT=443
VLESS_UUID=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
REALITY_SERVER_NAME=www.cloudflare.com
REALITY_FINGERPRINT=chrome
XHTTP_PATH=/xhttp
XHTTP_MODE=auto
XHTTP_HOST=
